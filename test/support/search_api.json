{
  "openapi": "3.1.0",
  "info": {
    "title": "Inventory API",
    "description": "A made-up API whose list endpoints take a query in a POST body.",
    "version": "1.0.0"
  },
  "paths": {
    "/products/search": {
      "post": {
        "operationId": "searchProducts",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SearchRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Matching products",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProductPage" } }
            }
          }
        }
      }
    },
    "/products": {
      "post": {
        "operationId": "createProduct",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
          }
        },
        "responses": {
          "201": {
            "description": "The created product",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
            }
          }
        }
      }
    },
    "/products/{productId}": {
      "get": {
        "operationId": "getProduct",
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "A product",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
            }
          }
        }
      }
    },
    "/sales/load": {
      "post": {
        "operationId": "loadSales",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CubeLoadRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Sales rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/SaleRow" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sales/export": {
      "post": {
        "operationId": "exportSales",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "format": { "type": "string" } } }
            }
          }
        },
        "responses": { "202": { "description": "Export started" } }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "properties": {
          "filters": { "type": "array", "items": { "$ref": "#/components/schemas/SearchFilter" } },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "SearchFilter": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "value": { "type": "string" }
        }
      },
      "ProductPage": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "total": { "type": "integer" }
        }
      },
      "Product": {
        "allOf": [
          { "$ref": "#/components/schemas/Entity" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "maxLength": 200 },
              "description": { "type": ["string", "null"] },
              "price": { "type": "number", "format": "float" },
              "cost": { "type": "number" },
              "stock": { "type": "integer" },
              "active": { "type": "boolean" },
              "status": { "type": "string", "enum": ["draft", "listed", "retired"] },
              "tags": { "type": "array", "items": { "type": "string" } },
              "releasedOn": { "type": "string", "format": "date" },
              "dimensions": { "type": "object", "properties": { "width": { "type": "number" } } }
            }
          }
        ]
      },
      "Entity": {
        "type": "object",
        "required": ["id", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CubeLoadRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "object",
            "properties": {
              "dimensions": { "type": "array", "items": { "type": "string" } },
              "filters": { "type": "array", "items": { "type": "object" } },
              "limit": { "type": "integer" }
            }
          }
        }
      },
      "SaleRow": {
        "type": "object",
        "properties": {
          "Sales.id": { "type": "integer" },
          "Sales.region": { "type": "string" },
          "Sales.amount": { "type": "number" }
        }
      }
    }
  }
}
